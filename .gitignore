requirements/

# Package manager lock files
# package-lock.json is committed for reproducible, pinned installs (supply-chain hygiene).
# npm never includes it in the published tarball, so consumers still resolve
# dependencies from package.json semver ranges.
yarn.lock
pnpm-lock.yaml
